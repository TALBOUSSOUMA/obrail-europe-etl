# Local overrides for the ETL's PostgreSQL connection (see etl/load.py).
# Not committed - copy this file's shape into your own .env if it's missing.
#
# Published on 5433 rather than Postgres' default 5432: a native
# PostgreSQL Windows service commonly claims 5432 on dev machines,
# which silently steals connections meant for the Docker container.
POSTGRES_USER=obrail
POSTGRES_PASSWORD=obrail
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=obrail

# Grafana admin password (docker-compose.yml, "grafana" service).
# Demo value below, not a real secret - change it before any real use.
# If this variable is absent, docker-compose.yml applies the same
# "obrail" fallback by default.
GRAFANA_ADMIN_PASSWORD=obrail
